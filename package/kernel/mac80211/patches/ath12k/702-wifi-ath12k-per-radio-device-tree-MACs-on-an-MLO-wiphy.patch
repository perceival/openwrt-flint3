From: CoolFreeze23 <34906576+CoolFreeze23@users.noreply.github.com>
Date: Wed, 21 Oct 2026 03:00:00 +0900
Subject: [PATCH] wifi: ath12k: per-radio device tree MACs on an MLO wiphy

With a device tree MAC (701), each radio of a device takes the device
address with its fifth byte bumped by the pdev index. On a dual-MAC
QCN9274 whose node holds ART@0x4 + 1, the 6 GHz radio becomes
xx:xx:xx:xx:(b4+1):xx, an address in another unit's range. Give the
radios the addresses that follow the device address instead, as the
vendor driver does (stock GL-BE9300: wifi0/1/2 = ART@0x4 + 0/1/2).

On a multi-radio (MLO) wiphy userspace sees one permanent address, so
wifi-scripts derives the interface addresses of every radio from radio
0's: the first AP of radio N becomes base + 16 * N, again a global
address another unit owns. When every radio of the wiphy has a device
tree address, publish the per-radio addresses as wiphy->addresses:
wifi-scripts (common.uc macaddr_generate()) already takes radio N's base
from entry N of /sys/class/ieee80211/phy*/addresses (0-based).

Devices without a device tree address keep the firmware address and
the old derivation. The list is published only when every radio's
address is from the device tree and all are distinct.

Read the address at the start of the bus probe instead of from the QMI
event work that starts the hardware group. of_get_mac_address() returns
-EPROBE_DEFER while the nvmem provider is not ready (since 6.18.45 also
until the nvmem fixed-layout driver has bound), and that work runs long
after probe, where the only option left was the firmware placeholder.
At the start of the probe nothing is set up yet, on AHB or on PCI, and
the device has not joined its hardware group, so a deferral needs no
unwinding and only delays the group, which waits for all of its devices
anyway.

The deferral is bounded by the driver core's deferred probe timeout: a
cell whose provider never appears ends with a warning and the firmware
address, not with a device that never probes. A node without a cell
never defers. While a device is deferred the devices behind it wait too,
because the probe order sets device_id and with it the radio indices and
the parent device of the wiphy.

Log the device tree address, and a failure to read one other than "no
address in the node", so the source of the MAC shows in dmesg.

Signed-off-by: CoolFreeze23 <34906576+CoolFreeze23@users.noreply.github.com>
---
diff --git a/drivers/net/wireless/ath/ath12k/ahb.c b/drivers/net/wireless/ath/ath12k/ahb.c
--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -1242,6 +1242,10 @@ static int ath12k_ahb_probe(struct platform_device *pdev)
 	if (!ab)
 		return -ENOMEM;
 
+	ret = ath12k_core_read_dt_mac_address(ab);
+	if (ret)
+		goto err_core_free;
+
 	ab_ahb = ath12k_ab_to_ahb(ab);
 	ab_ahb->ab = ab;
 	ab->hif.ops = &ath12k_ahb_hif_ops;
diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1206,17 +1206,75 @@ err_mlo_teardown:
 	return ret;
 }
 
-static void ath12k_core_get_mac_address(struct ath12k_base *ab)
+/* First device that deferred its probe for its address and has not come back
+ * yet. Protected with ath12k_hw_group_mutex.
+ */
+static const struct device *ath12k_mac_deferred_dev;
+
+/* Read the device tree address at the very start of the bus probe: nothing has
+ * been set up yet that a deferral would have to undo, and the device has not
+ * joined its hardware group. The place the address is used,
+ * ath12k_core_hw_group_start(), runs from the QMI event work long after probe
+ * has returned and cannot defer any more.
+ *
+ * The cell can be held by a provider that is not ready yet (a block device
+ * still being probed, a fixed-layout parser that has not bound), so
+ * -EPROBE_DEFER is passed on. It is bounded by the deferred probe timeout of
+ * the driver core, because a provider that never appears (the partition is
+ * gone, the eMMC has failed) must not cost the device its radios: from then on
+ * the device goes on with the firmware address, as it does with a blank cell.
+ * A node without such a cell returns -ENOENT or -ENODEV and never defers.
+ *
+ * The order in which the devices of a group finish probing sets their
+ * device_id, and through it the radio indices and the parent device of the
+ * wiphy, which is what /etc/config/wireless refers to. Hold back the devices
+ * behind one that deferred, or a provider coming up between the two probes
+ * would swap them.
+ */
+int ath12k_core_read_dt_mac_address(struct ath12k_base *ab)
 {
-	u8 mac_addr[ETH_ALEN];
+	struct device *dev = ab->dev;
+	int ret;
 
-	if (!ab->dev->of_node)
-		return;
+	if (!dev->of_node)
+		return 0;
+
+	ret = of_get_mac_address(dev->of_node, ab->dt_mac_addr);
+
+	mutex_lock(&ath12k_hw_group_mutex);
+	if ((ret == -EPROBE_DEFER ||
+	     (ath12k_mac_deferred_dev && ath12k_mac_deferred_dev != dev)) &&
+	    driver_deferred_probe_check_state(dev) == -EPROBE_DEFER) {
+		if (!ath12k_mac_deferred_dev)
+			ath12k_mac_deferred_dev = dev;
+		mutex_unlock(&ath12k_hw_group_mutex);
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for the device tree MAC address\n");
+	}
+	ath12k_mac_deferred_dev = NULL;
+	mutex_unlock(&ath12k_hw_group_mutex);
+
+	if (ret) {
+		/* -ENOENT/-ENODEV: the node has no address, which is fine */
+		if (ret != -ENOENT && ret != -ENODEV)
+			ath12k_warn(ab, "failed to read MAC address from device tree: %d, using the firmware address\n",
+				    ret);
+		return 0;
+	}
 
-	if (of_get_mac_address(ab->dev->of_node, mac_addr))
+	ab->mac_addr_from_dt = true;
+	ath12k_info(ab, "MAC address %pM from device tree\n", ab->dt_mac_addr);
+
+	return 0;
+}
+
+/* Firmware has reported its own address by now: replace it */
+static void ath12k_core_set_dt_mac_address(struct ath12k_base *ab)
+{
+	if (!ab->mac_addr_from_dt)
 		return;
 
-	ether_addr_copy(ab->mac_addr, mac_addr);
+	ether_addr_copy(ab->mac_addr, ab->dt_mac_addr);
 	ab->pdevs_macaddr_valid = false;
 }
 
@@ -1239,7 +1297,7 @@ static int ath12k_core_hw_group_start(struct ath12k_hw_group *ag)
 	for (i = 0; i < ag->num_devices; i++) {
 		ab = ag->ab[i];
 		if (ab)
-			ath12k_core_get_mac_address(ab);
+			ath12k_core_set_dt_mac_address(ab);
 	}
 
 	ret = ath12k_mac_allocate(ag);
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -814,6 +814,9 @@ struct ath12k_hw {
 
 	struct ath12k_dp_hw dp_hw;
 
+	/* per-radio addresses published as wiphy->addresses */
+	struct mac_address radio_addrs[ATH12K_GROUP_MAX_RADIO];
+
 	/* Keep last */
 	struct ath12k radio[] __aligned(sizeof(void *));
 };
@@ -1048,6 +1051,9 @@ struct ath12k_base {
 	struct ath12k_wmi_target_cap_arg target_caps;
 	u32 ext_service_bitmap[WMI_SERVICE_EXT_BM_SIZE];
 	bool pdevs_macaddr_valid;
+	/* mac_addr is taken from the device tree, not from firmware */
+	bool mac_addr_from_dt;
+	u8 dt_mac_addr[ETH_ALEN] __aligned(2);
 
 	const struct ath12k_hw_params *hw_params;
 
@@ -1288,6 +1294,7 @@ void ath12k_core_deinit(struct ath12k_base *ath12k);
 struct ath12k_base *ath12k_core_alloc(struct device *dev, size_t priv_size,
 				      enum ath12k_bus bus);
 void ath12k_core_free(struct ath12k_base *ath12k);
+int ath12k_core_read_dt_mac_address(struct ath12k_base *ab);
 int ath12k_core_fetch_board_data_api_1(struct ath12k_base *ab,
 				       struct ath12k_board_data *bd,
 				       char *filename);
diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -15036,6 +15036,43 @@ static int ath12k_mac_setup_register(struct ath12k *ar,
 	return 0;
 }
 
+/* A multi-radio (MLO) wiphy shows userspace a single permanent address, so
+ * every interface address is derived from radio 0's base, whatever radio it
+ * runs on. When each radio has its own device tree address, publish them as
+ * wiphy->addresses in radio order: cfg80211 lists them in
+ * /sys/class/ieee80211/phyN/addresses, which is where wifi-scripts takes the
+ * base address of radio N from. cfg80211 refuses a permanent address other
+ * than the first entry, so set that too (radio 0 is pdev 0 of its device, so
+ * this is the address it already had).
+ */
+static void ath12k_mac_hw_set_radio_addrs(struct ath12k_hw *ah)
+{
+	struct wiphy *wiphy = ah->hw->wiphy;
+	struct ath12k *ar;
+	int i, j;
+
+	wiphy->addresses = NULL;
+	wiphy->n_addresses = 0;
+
+	if (ah->num_radio < 2)
+		return;
+
+	for_each_ar(ah, ar, i) {
+		if (!ar->ab->mac_addr_from_dt)
+			return;
+
+		for (j = 0; j < i; j++)
+			if (ether_addr_equal(ah->radio_addrs[j].addr, ar->mac_addr))
+				return;
+
+		ether_addr_copy(ah->radio_addrs[i].addr, ar->mac_addr);
+	}
+
+	wiphy->addresses = ah->radio_addrs;
+	wiphy->n_addresses = ah->num_radio;
+	ether_addr_copy(wiphy->perm_addr, ah->radio_addrs[0].addr);
+}
+
 static int ath12k_mac_hw_register(struct ath12k_hw *ah)
 {
 	struct ieee80211_hw *hw = ah->hw;
@@ -15069,6 +15106,14 @@ static int ath12k_mac_hw_register(struct ath12k_hw *ah)
 		pdev = ar->pdev;
 		if (ar->ab->pdevs_macaddr_valid) {
 			ether_addr_copy(ar->mac_addr, pdev->mac_addr);
+		} else if (ar->ab->mac_addr_from_dt) {
+			/* A device tree address is the device's own base: its
+			 * radios take the addresses that follow it, as the
+			 * vendor driver does, not a fifth-byte bump into an
+			 * address range that belongs to another unit.
+			 */
+			ether_addr_copy(ar->mac_addr, ar->ab->mac_addr);
+			eth_addr_add(ar->mac_addr, ar->pdev_idx);
 		} else {
 			ether_addr_copy(ar->mac_addr, ar->ab->mac_addr);
 			ar->mac_addr[4] += ar->pdev_idx;
@@ -15114,6 +15159,7 @@ static int ath12k_mac_hw_register(struct ath12k_hw *ah)
 	wiphy->available_antennas_tx = antennas_tx;
 
 	SET_IEEE80211_PERM_ADDR(hw, mac_addr);
+	ath12k_mac_hw_set_radio_addrs(ah);
 	SET_IEEE80211_DEV(hw, ab->dev);
 
 	ret = ath12k_mac_setup_iface_combinations(ah);
diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -1552,6 +1552,10 @@ static int ath12k_pci_probe(struct pci_dev *pdev,
 		return -ENOMEM;
 	}
 
+	ret = ath12k_core_read_dt_mac_address(ab);
+	if (ret)
+		goto err_free_core;
+
 	ab->dev = &pdev->dev;
 	ab_pci = ath12k_pci_priv(ab);
 	ab_pci->dev_id = pci_dev->device;
