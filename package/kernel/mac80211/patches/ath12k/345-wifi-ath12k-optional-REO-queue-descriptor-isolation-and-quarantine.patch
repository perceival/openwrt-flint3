From: CoolFreeze23 <34906576+CoolFreeze23@users.noreply.github.com>
Date: Tue, 20 Oct 2026 12:00:00 +0900
Subject: [PATCH] wifi: ath12k: optional REO queue descriptor isolation and quarantine

Diagnostic for the netlink_release() panics (netlink_sock and the REO
queue descriptors share kmalloc-2k). Off by default; enable with the
ath12k module parameter reoq_debug=1 (read-only after load).

When enabled, REO queue descriptors come from a dedicated non-mergeable
slab, so a late hardware write can no longer hit another object. Freed
descriptors are poisoned, cleaned to DRAM and held for 10 s; on release
any byte the hardware changed after the free is reported with a
hexdump (the 0x?DBEEF header magic identifies REO descriptors).

When disabled, allocation and free use kzalloc()/kfree() exactly as
before.
---
diff --git a/drivers/net/wireless/ath/ath12k/dp_rx.c b/drivers/net/wireless/ath/ath12k/dp_rx.c
--- a/drivers/net/wireless/ath/ath12k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.c
@@ -361,13 +361,168 @@ void ath12k_dp_init_rx_tid_rxq(struct ath12k_dp_rx_tid_rxq *rx_tid_rxq,
 }
 EXPORT_SYMBOL(ath12k_dp_init_rx_tid_rxq);
 
+/* REO queue descriptors are read and written by the REO hardware.  With
+ * reoq_debug=1, keep them out of the generic kmalloc-2k cache (netlink
+ * sockets live there), and hold freed ones back, poisoned, so a late
+ * hardware write is caught instead of landing in an unrelated object.
+ * Diagnostic only, off by default. Read once at module load (0444): the
+ * allocator must not change while descriptors are outstanding.
+ */
+static bool ath12k_reoq_debug;
+module_param_named(reoq_debug, ath12k_reoq_debug, bool, 0444);
+MODULE_PARM_DESC(reoq_debug,
+		 "Isolate REO queue descriptors in their own slab and report writes after free (diagnostic)");
+
+#define ATH12K_REOQ_OBJ_SIZE		2048
+#define ATH12K_REOQ_QUARANTINE_MS	10000
+#define ATH12K_REOQ_POISON		0x6b
+
+struct ath12k_reoq_quarantine {
+	struct list_head list;
+	struct device *dev;
+	void *vaddr;
+	dma_addr_t paddr;
+	unsigned long ts;
+};
+
+static struct kmem_cache *ath12k_reoq_cache;
+static LIST_HEAD(ath12k_reoq_quarantine_list);
+static DEFINE_SPINLOCK(ath12k_reoq_quarantine_lock);
+
+int ath12k_dp_rx_reoq_cache_init(void)
+{
+	if (!ath12k_reoq_debug)
+		return 0;
+
+	pr_info("ath12k: REO queue descriptor isolation and quarantine enabled\n");
+	ath12k_reoq_cache = kmem_cache_create("ath12k_reoq", ATH12K_REOQ_OBJ_SIZE,
+					      HAL_LINK_DESC_ALIGN, SLAB_NO_MERGE,
+					      NULL);
+	return ath12k_reoq_cache ? 0 : -ENOMEM;
+}
+EXPORT_SYMBOL(ath12k_dp_rx_reoq_cache_init);
+
+void ath12k_dp_rx_reoq_cache_exit(void)
+{
+	struct ath12k_reoq_quarantine *q, *tmp;
+
+	if (!ath12k_reoq_cache)
+		return;
+
+	/* The devices are gone; release without touching their mappings. */
+	list_for_each_entry_safe(q, tmp, &ath12k_reoq_quarantine_list, list) {
+		list_del(&q->list);
+		kmem_cache_free(ath12k_reoq_cache, q->vaddr);
+		kfree(q);
+	}
+	kmem_cache_destroy(ath12k_reoq_cache);
+	ath12k_reoq_cache = NULL;
+}
+EXPORT_SYMBOL(ath12k_dp_rx_reoq_cache_exit);
+
+void *ath12k_dp_rx_reoq_alloc(size_t size, gfp_t gfp)
+{
+	if (!ath12k_reoq_cache)
+		return kzalloc(size, gfp);
+
+	if (WARN_ON_ONCE(size > ATH12K_REOQ_OBJ_SIZE))
+		return NULL;
+
+	return kmem_cache_zalloc(ath12k_reoq_cache, gfp);
+}
+EXPORT_SYMBOL(ath12k_dp_rx_reoq_alloc);
+
+/* For a descriptor that was never handed to hardware. */
+void ath12k_dp_rx_reoq_free_unused(void *vaddr)
+{
+	if (!ath12k_reoq_cache) {
+		kfree(vaddr);
+		return;
+	}
+
+	kmem_cache_free(ath12k_reoq_cache, vaddr);
+}
+EXPORT_SYMBOL(ath12k_dp_rx_reoq_free_unused);
+
+static void ath12k_dp_rx_reoq_release(struct ath12k_reoq_quarantine *q)
+{
+	u8 *p = q->vaddr;
+	int i;
+
+	/* Invalidates the CPU cache, so the check below reads DRAM. */
+	dma_unmap_single(q->dev, q->paddr, ATH12K_REOQ_OBJ_SIZE,
+			 DMA_BIDIRECTIONAL);
+
+	for (i = 0; i < ATH12K_REOQ_OBJ_SIZE; i++)
+		if (p[i] != ATH12K_REOQ_POISON)
+			break;
+
+	if (i < ATH12K_REOQ_OBJ_SIZE) {
+		dev_err(q->dev,
+			"REO queue descriptor %pad written after free (within %u ms, first byte at %d)\n",
+			&q->paddr, jiffies_to_msecs(jiffies - q->ts), i);
+		print_hex_dump(KERN_ERR, "reoq: ", DUMP_PREFIX_OFFSET, 16, 4,
+			       p, 256, false);
+		WARN_ON_ONCE(1);
+	}
+
+	kmem_cache_free(ath12k_reoq_cache, q->vaddr);
+	kfree(q);
+}
+
+static void ath12k_dp_rx_reoq_quarantine(struct device *dev, void *vaddr)
+{
+	struct ath12k_reoq_quarantine *q, *tmp;
+	unsigned long flags;
+	LIST_HEAD(expired);
+
+	q = kmalloc(sizeof(*q), GFP_ATOMIC);
+	if (q) {
+		memset(vaddr, ATH12K_REOQ_POISON, ATH12K_REOQ_OBJ_SIZE);
+		/* Clean the poison to DRAM: the device is not coherent. */
+		q->paddr = dma_map_single(dev, vaddr, ATH12K_REOQ_OBJ_SIZE,
+					  DMA_BIDIRECTIONAL);
+		if (dma_mapping_error(dev, q->paddr)) {
+			kfree(q);
+			q = NULL;
+		}
+	}
+
+	if (q) {
+		q->dev = dev;
+		q->vaddr = vaddr;
+		q->ts = jiffies;
+	} else {
+		kmem_cache_free(ath12k_reoq_cache, vaddr);
+	}
+
+	spin_lock_irqsave(&ath12k_reoq_quarantine_lock, flags);
+	if (q)
+		list_add_tail(&q->list, &ath12k_reoq_quarantine_list);
+	list_for_each_entry_safe(q, tmp, &ath12k_reoq_quarantine_list, list) {
+		if (!time_after(jiffies, q->ts +
+				msecs_to_jiffies(ATH12K_REOQ_QUARANTINE_MS)))
+			break;
+		list_move_tail(&q->list, &expired);
+	}
+	spin_unlock_irqrestore(&ath12k_reoq_quarantine_lock, flags);
+
+	list_for_each_entry_safe(q, tmp, &expired, list) {
+		list_del(&q->list);
+		ath12k_dp_rx_reoq_release(q);
+	}
+}
+
 static void ath12k_dp_rx_tid_cleanup(struct ath12k_base *ab,
 				     struct ath12k_reoq_buf *tid_qbuf)
 {
 	if (tid_qbuf->vaddr) {
 		dma_unmap_single(ab->dev, tid_qbuf->paddr_aligned,
 				 tid_qbuf->size, DMA_BIDIRECTIONAL);
-		kfree(tid_qbuf->vaddr);
+		if (ath12k_reoq_cache)
+			ath12k_dp_rx_reoq_quarantine(ab->dev, tid_qbuf->vaddr);
+		else
+			kfree(tid_qbuf->vaddr);
 		tid_qbuf->vaddr = NULL;
 	}
 }
diff --git a/drivers/net/wireless/ath/ath12k/dp_rx.h b/drivers/net/wireless/ath/ath12k/dp_rx.h
--- a/drivers/net/wireless/ath/ath12k/dp_rx.h
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.h
@@ -232,6 +232,10 @@ void ath12k_dp_rx_free(struct ath12k_base *ab);
 int ath12k_dp_rx_pdev_alloc(struct ath12k_base *ab, int pdev_idx);
 void ath12k_dp_rx_pdev_free(struct ath12k_base *ab, int pdev_idx);
 void ath12k_dp_rx_reo_cmd_list_cleanup(struct ath12k_base *ab);
+int ath12k_dp_rx_reoq_cache_init(void);
+void ath12k_dp_rx_reoq_cache_exit(void);
+void *ath12k_dp_rx_reoq_alloc(size_t size, gfp_t gfp);
+void ath12k_dp_rx_reoq_free_unused(void *vaddr);
 int ath12k_dp_rx_bufs_replenish(struct ath12k_dp *dp,
 				struct dp_rxdma_ring *rx_ring,
 				struct list_head *used_list,
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/core.c b/drivers/net/wireless/ath/ath12k/wifi7/core.c
--- a/drivers/net/wireless/ath/ath12k/wifi7/core.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/core.c
@@ -12,6 +12,7 @@
 #include "core.h"
 #include "dp.h"
 #include "../debug.h"
+#include "../dp_rx.h"
 
 static int ahb_err, pci_err;
 
@@ -38,6 +39,12 @@ void ath12k_wifi7_arch_deinit(struct ath12k_base *ab)
 
 static int ath12k_wifi7_init(void)
 {
+	int ret;
+
+	ret = ath12k_dp_rx_reoq_cache_init();
+	if (ret)
+		return ret;
+
 	ahb_err = ath12k_wifi7_ahb_init();
 	if (ahb_err)
 		pr_warn("Failed to initialize ath12k Wi-Fi 7 AHB device: %d\n",
@@ -49,7 +56,12 @@ static int ath12k_wifi7_init(void)
 			pci_err);
 
 	/* If both failed, return one of the failures (arbitrary) */
-	return ahb_err && pci_err ? ahb_err : 0;
+	if (ahb_err && pci_err) {
+		ath12k_dp_rx_reoq_cache_exit();
+		return ahb_err;
+	}
+
+	return 0;
 }
 
 static void ath12k_wifi7_exit(void)
@@ -59,6 +71,8 @@ static void ath12k_wifi7_exit(void)
 
 	if (!ahb_err)
 		ath12k_wifi7_ahb_exit();
+
+	ath12k_dp_rx_reoq_cache_exit();
 }
 
 module_init(ath12k_wifi7_init);
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
@@ -273,7 +273,8 @@ int ath12k_wifi7_dp_rx_assign_reoq(struct ath12k_base *ab, struct ath12k_dp_peer
 			hw_desc_sz = ath12k_wifi7_hal_reo_qdesc_size(DP_BA_WIN_SZ_MAX,
 								     tid);
 
-		vaddr = kzalloc(hw_desc_sz + HAL_LINK_DESC_ALIGN - 1, GFP_ATOMIC);
+		vaddr = ath12k_dp_rx_reoq_alloc(hw_desc_sz + HAL_LINK_DESC_ALIGN - 1,
+						GFP_ATOMIC);
 		if (!vaddr)
 			return -ENOMEM;
 
@@ -286,7 +287,7 @@ int ath12k_wifi7_dp_rx_assign_reoq(struct ath12k_base *ab, struct ath12k_dp_peer
 					       DMA_BIDIRECTIONAL);
 		ret = dma_mapping_error(ab->dev, paddr_aligned);
 		if (ret) {
-			kfree(vaddr);
+			ath12k_dp_rx_reoq_free_unused(vaddr);
 			return ret;
 		}
 
