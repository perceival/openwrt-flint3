+#ifdef CONFIG_IEEE80211BE
+
+static bool wpa_ft_mlo(const struct wpa_state_machine *sm)
+{
+	return sm->mld_assoc_link_id >= 0;
+}
+
+
+/*
+ * Link addresses of the non-AP MLD (ap == false) or BSSIDs of the affiliated
+ * APs of the AP MLD (ap == true) for the links negotiated by the STA,
+ * concatenated in increasing link ID order. These are included in the FTE MIC
+ * calculation for MLO (IEEE Std 802.11be, 13.8.4 and 13.8.5).
+ */
+static struct wpabuf * wpa_ft_mlo_link_addrs(struct wpa_state_machine *sm,
+					     bool ap)
+{
+	struct wpabuf *buf;
+	unsigned int link_id;
+
+	buf = wpabuf_alloc(MAX_NUM_MLD_LINKS * ETH_ALEN);
+	if (!buf)
+		return NULL;
+
+	for (link_id = 0; link_id < MAX_NUM_MLD_LINKS; link_id++) {
+		const struct mld_link *link = &sm->mld_links[link_id];
+
+		if (!link->valid || !link->wpa_auth)
+			continue;
+		wpabuf_put_data(buf, ap ? link->wpa_auth->addr : link->peer_addr,
+				ETH_ALEN);
+		wpa_printf(MSG_DEBUG, "FT: MLO link %u %s address " MACSTR,
+			   link_id, ap ? "AP" : "STA",
+			   MAC2STR(ap ? link->wpa_auth->addr :
+				   link->peer_addr));
+	}
+
+	return buf;
+}
+
+
+/*
+ * RSNEs (or RSNXEs, if rsnxe) of the affiliated APs of the AP MLD for the
+ * links negotiated by the STA, concatenated in increasing link ID order. The
+ * number of elements included is returned in *count.
+ */
+static struct wpabuf * wpa_ft_mlo_link_rsn_ies(struct wpa_state_machine *sm,
+					       bool rsnxe, unsigned int *count)
+{
+	struct wpabuf *buf;
+	unsigned int link_id;
+
+	*count = 0;
+	buf = wpabuf_alloc(MAX_NUM_MLD_LINKS * 257);
+	if (!buf)
+		return NULL;
+
+	for (link_id = 0; link_id < MAX_NUM_MLD_LINKS; link_id++) {
+		const struct mld_link *link = &sm->mld_links[link_id];
+		const struct wpa_authenticator *la = link->wpa_auth;
+		const u8 *ie;
+
+		if (!link->valid || !la)
+			continue;
+		ie = get_ie(la->wpa_ie, la->wpa_ie_len,
+			    rsnxe ? WLAN_EID_RSNX : WLAN_EID_RSN);
+		if (!ie)
+			continue;
+		wpabuf_put_data(buf, ie, 2 + ie[1]);
+		(*count)++;
+	}
+
+	return buf;
+}
+
+
+static int wpa_ft_mlo_wrap_key(const u8 *kek, size_t kek_len, const u8 *key,
+			       size_t key_len, u8 *out, const char *name)
+{
+	if (aes_wrap(kek, kek_len, key_len / 8, key, out)) {
+		wpa_printf(MSG_DEBUG,
+			   "FT: MLO %s subelem encryption failed: kek_len=%d",
+			   name, (int) kek_len);
+		return -1;
+	}
+	return 0;
+}
+
+
+/*
+ * MLO GTK, MLO IGTK, and MLO BIGTK subelements for all links negotiated by the
+ * STA. The formats match the non-MLO GTK/IGTK/BIGTK subelements with a Link ID
+ * Info field added after Key Info (GTK) or after IPN/BIPN (IGTK/BIGTK).
+ */
+static u8 * wpa_ft_mlo_group_key_subelems(struct wpa_state_machine *sm,
+					  size_t *len, int vlan_id)
+{
+	struct wpa_auth_config *conf = &sm->wpa_auth->conf;
+	const u8 *kek;
+	size_t kek_len;
+	u8 *buf, *pos;
+	size_t buflen;
+	unsigned int link_id;
+
+	if (wpa_key_mgmt_fils(sm->wpa_key_mgmt)) {
+		kek = sm->PTK.kek2;
+		kek_len = sm->PTK.kek2_len;
+	} else {
+		kek = sm->PTK.kek;
+		kek_len = sm->PTK.kek_len;
+	}
+
+	/* Worst case per link: GTK 2+2+1+1+8+(32+8+8) and two times
+	 * IGTK/BIGTK 2+2+6+1+1+(32+8) */
+	buflen = MAX_NUM_MLD_LINKS * (62 + 2 * 52);
+	buf = os_zalloc(buflen);
+	if (!buf)
+		return NULL;
+	pos = buf;
+
+	for (link_id = 0; link_id < MAX_NUM_MLD_LINKS; link_id++) {
+		struct mld_link *link = &sm->mld_links[link_id];
+		struct wpa_auth_ml_link_key_info info;
+		u8 keybuf[WPA_GTK_MAX_LEN];
+		size_t key_len, pad_len;
+
+		if (!link->valid || !link->wpa_auth)
+			continue;
+
+		os_memset(&info, 0, sizeof(info));
+		info.link_id = link_id;
+		wpa_auth_ml_get_key_info(link->wpa_auth, &info,
+					 sm->mgmt_frame_prot, conf->beacon_prot,
+					 false, vlan_id);
+
+		/* MLO GTK: Sub-elem ID[1] | Length[1] | Key Info[2] |
+		 * Link ID Info[1] | Key Length[1] | RSC[8] | Key[5..32] */
+		key_len = info.gtk_len;
+		if (!info.gtk || !key_len || key_len > sizeof(keybuf))
+			goto fail;
+		os_memcpy(keybuf, info.gtk, key_len);
+		if (conf->disable_gtk && random_get_bytes(keybuf, key_len) < 0)
+			goto fail;
+		/* Pad key for AES Key Wrap if it is not multiple of 8 bytes or
+		 * is less than 16 bytes. */
+		pad_len = key_len % 8;
+		if (pad_len)
+			pad_len = 8 - pad_len;
+		if (key_len + pad_len < 16)
+			pad_len += 8;
+		if (pad_len) {
+			os_memset(keybuf + key_len, 0, pad_len);
+			keybuf[key_len] = 0xdd;
+			key_len += pad_len;
+		}
+
+		wpa_printf(MSG_DEBUG, "FT: MLO GTK subelem: link=%u", link_id);
+		*pos++ = FTIE_SUBELEM_MLO_GTK;
+		*pos++ = 2 + 1 + 1 + 8 + key_len + 8;
+		WPA_PUT_LE16(pos, info.gtkidx & 0x03);
+		pos += 2;
+		*pos++ = link_id & 0x0f;
+		*pos++ = info.gtk_len;
+		os_memcpy(pos, info.pn, 6); /* RSC = PN[6] || 0[2] */
+		pos += 8;
+		if (wpa_ft_mlo_wrap_key(kek, kek_len, keybuf, key_len, pos,
+					"GTK") < 0) {
+			forced_memzero(keybuf, sizeof(keybuf));
+			goto fail;
+		}
+		forced_memzero(keybuf, sizeof(keybuf));
+		pos += key_len + 8;
+
+		if (!sm->mgmt_frame_prot)
+			continue;
+
+		/* MLO IGTK: Sub-elem ID[1] | Length[1] | KeyID[2] | IPN[6] |
+		 * Link ID Info[1] | Key Length[1] | Key[16+8] */
+		if (!info.igtk || !info.igtk_len)
+			goto fail;
+		wpa_printf(MSG_DEBUG, "FT: MLO IGTK subelem: link=%u", link_id);
+		*pos++ = FTIE_SUBELEM_MLO_IGTK;
+		*pos++ = 2 + 6 + 1 + 1 + info.igtk_len + 8;
+		WPA_PUT_LE16(pos, info.igtkidx);
+		pos += 2;
+		os_memcpy(pos, info.ipn, 6);
+		pos += 6;
+		*pos++ = link_id & 0x0f;
+		*pos++ = info.igtk_len;
+		if (wpa_ft_mlo_wrap_key(kek, kek_len, info.igtk, info.igtk_len,
+					pos, "IGTK") < 0)
+			goto fail;
+		pos += info.igtk_len + 8;
+
+		if (!conf->beacon_prot || !info.bigtk)
+			continue;
+
+		/* MLO BIGTK: Sub-elem ID[1] | Length[1] | KeyID[2] | BIPN[6] |
+		 * Link ID Info[1] | Key Length[1] | Key[16+8] */
+		wpa_printf(MSG_DEBUG, "FT: MLO BIGTK subelem: link=%u",
+			   link_id);
+		*pos++ = FTIE_SUBELEM_MLO_BIGTK;
+		*pos++ = 2 + 6 + 1 + 1 + info.igtk_len + 8;
+		WPA_PUT_LE16(pos, info.bigtkidx);
+		pos += 2;
+		os_memcpy(pos, info.bipn, 6);
+		pos += 6;
+		*pos++ = link_id & 0x0f;
+		*pos++ = info.igtk_len;
+		if (wpa_ft_mlo_wrap_key(kek, kek_len, info.bigtk, info.igtk_len,
+					pos, "BIGTK") < 0)
+			goto fail;
+		pos += info.igtk_len + 8;
+	}
+
+	*len = pos - buf;
+	return buf;
+fail:
+	bin_clear_free(buf, buflen);
+	return NULL;
+}
+
+#else /* CONFIG_IEEE80211BE */
+
+static bool wpa_ft_mlo(const struct wpa_state_machine *sm)
+{
+	return false;
+}
