  *
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_offload.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_offload.h
@@ -6,9 +6,14 @@
 #ifndef __PPE_OFFLOAD_H__
 #define __PPE_OFFLOAD_H__
 
