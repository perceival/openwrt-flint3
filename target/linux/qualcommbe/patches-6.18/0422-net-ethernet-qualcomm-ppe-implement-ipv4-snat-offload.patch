 int ppe_offload_setup_tc(struct net_device *netdev, enum tc_setup_type type,
 			  void *type_data);
 
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_offload.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_offload.c
@@ -7,43 +7,457 @@
  * this driver's netdevices, modeled on drivers/net/ethernet/mediatek/
  * mtk_ppe_offload.c.
  *
- * This is deliberately the *inert* half only: it registers the TC
- * block callback so the kernel's flow-offload infrastructure can find
- * this driver and offer it flows, but ppe_offload_flow_cmd() declines
- * every FLOW_CLS_REPLACE with -EOPNOTSUPP rather than actually parsing
- * a flow_rule and programming hardware. That is the next piece, and is
- * gated on its own review -- unlike this file, it will not be inert.
+ * Scope of what this accepts, deliberately narrow for a first working
+ * cut and enforced by outright declining (-EOPNOTSUPP) anything
+ * outside it, falling back to the kernel's normal software forwarding
+ * path:
  *
- * Only one PPE instance exists per SoC, so a single file-scope block
- * callback list (rather than one embedded in some per-device context
- * struct) is sufficient here and avoids introducing state this half
- * doesn't need. The hardware-programming half will need real
- * per-device state (an rhashtable of offloaded flows, references to
- * the host/nexthop pools) and is expected to introduce that struct
- * when it lands.
+ * - IPv4 only.
+ * - TCP, UDP or UDP-Lite only.
+ * - SNAT (source NAT / masquerade) direction only -- the reply/DNAT
+ *   direction of a NAT connection is a separate flow_cls_offload with
+ *   its own cookie and is declined here. A masqueraded connection is
+ *   therefore accelerated outbound but stays on the software path
+ *   inbound, which is a real, known limitation of this milestone, not
+ *   an oversight.
+ * - Egress device must be one of this driver's own EDMA port
+ *   netdevices (edma_port_is_edma_netdev()). Bridge and DSA (rtl837x)
+ *   netdevices are out of scope -- on this board's LAN side, real
+ *   traffic's egress device is typically a DSA/bridge netdevice, not
+ *   an EDMA one, so this milestone in practice only accelerates the
+ *   WAN-side direction of traffic through a plain EDMA netdevice.
+ *   Extending this to DSA/bridge devices (mirroring
+ *   mtk_flow_get_dsa_port()) is follow-up work.
+ * - The flow must carry a FLOW_ACTION_MANGLE for the Ethernet header:
+ *   this is the *only* source this code uses for the nexthop's
+ *   destination MAC, deliberately -- the kernel has already resolved
+ *   the correct next-hop MAC via its own routing/neighbor tables by
+ *   the time it offers the flow, so there's no reason to duplicate
+ *   that resolution here (and every reason not to, since getting it
+ *   wrong would misdirect real traffic).
+ * - FLOW_CLS_STATS is not implemented: this table's per-flow "age"
+ *   field isn't a packet/byte counter, and hardware keeps those
+ *   separately in a table this driver doesn't yet have a primitive
+ *   for. A long-lived offloaded connection can therefore be aged out
+ *   of conntrack independently of whether hardware is still
+ *   forwarding it -- acceptable for this milestone ("flows are
+ *   accepted and correctly forwarded"), not yet "flows survive
+ *   indefinitely once offloaded".
+ *
+ * Hardware itself may also not consult the flow table at all yet for
+ * genuinely external ingress traffic -- ppe_servcode_init() bypasses
+ * flow lookup (PPE_SC_BYPASS_INGRESS_FLOW_LOOKUP) only for service
+ * code 1, which edma_tx.c applies solely to CPU-originated egress
+ * descriptors, not to arriving port traffic, so external ingress
+ * should default to an unbypassed (zeroed) bitmap and see flow lookup
+ * -- but this has not been confirmed against a live register read.
+ * That confirmation, along with everything else in this comment, is a
+ * hardware-testing-time question; nothing here changes it.
  */
 
+#include <linux/errno.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <linux/in.h>
+#include <linux/ip.h>
 #include <linux/list.h>
+#include <linux/mutex.h>
 #include <linux/netdevice.h>
+#include <linux/rhashtable.h>
+#include <linux/slab.h>
+#include <linux/tcp.h>
 #include <net/flow_offload.h>
 #include <net/pkt_cls.h>
 
+#include "edma_port.h"
+#include "ppe.h"
+#include "ppe_flow.h"
+#include "ppe_flow_ipv4.h"
+#include "ppe_host.h"
+#include "ppe_host_ipv4.h"
+#include "ppe_host_pool.h"
+#include "ppe_nexthop.h"
+#include "ppe_nexthop_pool.h"
 #include "ppe_offload.h"
+#include "ppe_pub_ip_pool.h"
+
+struct ppe_offload_flow_entry {
+	struct rhash_head node;
+	unsigned long cookie;
+	u32 flow_index;
+	u32 host_index;
+	u32 nexthop_index;
+	u32 pub_ip_index;
+};
+
+static const struct rhashtable_params ppe_offload_flow_ht_params = {
+	.head_offset = offsetof(struct ppe_offload_flow_entry, node),
+	.key_offset = offsetof(struct ppe_offload_flow_entry, cookie),
+	.key_len = sizeof(unsigned long),
+	.automatic_shrinking = true,
+};
+
+/**
+ * struct ppe_offload_priv - PPE hardware flow-offload state.
+ * @ppe_dev: PPE device.
+ * @host_pool: Refcounted host table allocator.
+ * @nexthop_pool: Refcounted nexthop table allocator.
+ * @pub_ip_pool: Refcounted public IP address table allocator.
+ * @flow_table: Offloaded flows, keyed by TC flow cookie.
+ * @lock: Serializes the whole replace/destroy sequence -- looking up
+ * @flow_table, allocating from the pools, and programming hardware --
+ * against concurrent calls for different flows, mirroring
+ * mtk_ppe_offload.c's single mtk_flow_offload_mutex.
+ */
+struct ppe_offload_priv {
+	struct ppe_device *ppe_dev;
+	struct ppe_host_pool host_pool;
+	struct ppe_nexthop_pool nexthop_pool;
+	struct ppe_pub_ip_pool pub_ip_pool;
+	struct rhashtable flow_table;
+	struct mutex lock;
+};
 
 static LIST_HEAD(ppe_offload_block_cb_list);
 
-static int ppe_offload_flow_cmd(struct net_device *netdev, struct flow_cls_offload *cls)
+/* Local, zero-seeded accumulator for a FLOW_ACTION_MANGLE targeting
+ * the Ethernet header: the kernel emits up to three 4-byte masked
+ * mangles across the 12-byte dst+src region (at offsets 0, 4 and 8;
+ * the offset-4 word straddles h_dest[4..5] and h_source[0..1]), so a
+ * mangle can't be mapped one-to-one onto either address -- this must
+ * accumulate across all of them before the result means anything.
+ * Zero-seeded, not seeded from the original frame's addresses: a
+ * routed/NAT'd frame's new Ethernet header has no relationship to the
+ * original one, unlike the IPv4/port mangles below which only ever
+ * change one endpoint of an existing tuple.
+ */
+struct ppe_offload_eth_mangle {
+	u8 bytes[ETH_ALEN * 2];
+	bool seen;
+};
+
+static int ppe_offload_apply_eth_mangle(struct ppe_offload_eth_mangle *eth,
+					 const struct flow_action_entry *act)
+{
+	u32 *word;
+
+	if (act->mangle.offset > sizeof(eth->bytes) - sizeof(u32))
+		return -EOPNOTSUPP;
+
+	word = (u32 *)(eth->bytes + act->mangle.offset);
+	*word = (*word & act->mangle.mask) | act->mangle.val;
+	eth->seen = true;
+
+	return 0;
+}
+
+static __be32 ppe_offload_apply_ip4_mangle(__be32 orig, const struct flow_action_entry *act)
+{
+	u32 word = (__force u32)orig;
+
+	word = (word & act->mangle.mask) | act->mangle.val;
+
+	return (__force __be32)word;
+}
+
+/* Local accumulator for a FLOW_ACTION_MANGLE targeting the TCP/UDP
+ * source+dest port pair, both of which live in the first 4 bytes of
+ * either header (struct tcphdr and struct udphdr agree on this
+ * layout) and so can be covered by a single mangle at offset 0.
+ * Seeded from the original match ports, not zero: unlike the Ethernet
+ * header, only one of source/dest is ever actually being rewritten
+ * for the SNAT case this code supports, and the other must be
+ * preserved.
+ */
+struct ppe_offload_l4_ports {
+	__be16 source;
+	__be16 dest;
+};
+
+static int ppe_offload_apply_l4_mangle(struct ppe_offload_l4_ports *ports,
+					const struct flow_action_entry *act)
+{
+	u32 word;
+
+	if (act->mangle.offset != 0)
+		return -EOPNOTSUPP;
+
+	word = (__force u32)ports->source << 16 | (__force u32)ports->dest;
+	word = (word & act->mangle.mask) | act->mangle.val;
+	ports->source = (__force __be16)(word >> 16);
+	ports->dest = (__force __be16)(word & 0xffff);
+
+	return 0;
+}
+
+static int ppe_offload_flow_replace(struct net_device *netdev,
+				     struct ppe_offload_priv *priv,
+				     struct flow_cls_offload *cls)
+{
+	struct ppe_offload_l4_ports l4 = {};
+	struct ppe_offload_eth_mangle eth = {};
+	struct flow_rule *rule = flow_cls_offload_flow_rule(cls);
+	struct ppe_offload_flow_entry *entry;
+	struct ppe_host_ipv4_entry host_ipv4;
+	struct ppe_flow_ipv4_snat_entry flow_ipv4;
+	struct ppe_nexthop_entry nexthop;
+	struct edma_port_priv *port_priv;
+	struct net_device *odev = NULL;
+	__be32 match_src, match_dst;
+	__be32 new_src, new_dst;
+	__be16 match_sport, match_dport;
+	u32 flow_words[PPE_FLOW_TBL_ENTRY_WORDS];
+	u32 host_words[PPE_HOST_TBL_IPV4_ENTRY_WORDS];
+	u32 host_index, nexthop_index, pub_ip_index, flow_index;
+	const struct flow_action_entry *act;
+	u8 ip_proto;
+	int action;
+	int ret;
+
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS))
+		return -EOPNOTSUPP;
+
+	{
+		struct flow_match_control ctrl;
+		struct flow_match_basic basic;
+		struct flow_match_ipv4_addrs ip4;
+		struct flow_match_ports ports;
+
+		flow_rule_match_control(rule, &ctrl);
+		if (ctrl.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS)
+			return -EOPNOTSUPP;
+
+		flow_rule_match_basic(rule, &basic);
+		switch (basic.key->ip_proto) {
+		case IPPROTO_TCP:
+			ip_proto = PPE_FLOW_PROTO_TCP;
+			break;
+		case IPPROTO_UDP:
+			ip_proto = PPE_FLOW_PROTO_UDP;
+			break;
+		case IPPROTO_UDPLITE:
+			ip_proto = PPE_FLOW_PROTO_UDPLITE;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+
+		flow_rule_match_ipv4_addrs(rule, &ip4);
+		match_src = ip4.key->src;
+		match_dst = ip4.key->dst;
+
+		flow_rule_match_ports(rule, &ports);
+		match_sport = ports.key->src;
+		match_dport = ports.key->dst;
+	}
+
+	new_src = match_src;
+	new_dst = match_dst;
+	l4.source = match_sport;
+	l4.dest = match_dport;
+
+	flow_action_for_each(action, act, &rule->action) {
+		switch (act->id) {
+		case FLOW_ACTION_MANGLE:
+			switch (act->mangle.htype) {
+			case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+				ret = ppe_offload_apply_eth_mangle(&eth, act);
+				if (ret)
+					return ret;
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+				if (act->mangle.offset == offsetof(struct iphdr, saddr))
+					new_src = ppe_offload_apply_ip4_mangle(new_src, act);
+				else if (act->mangle.offset == offsetof(struct iphdr, daddr))
+					new_dst = ppe_offload_apply_ip4_mangle(new_dst, act);
+				else
+					return -EOPNOTSUPP;
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+			case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+				ret = ppe_offload_apply_l4_mangle(&l4, act);
+				if (ret)
+					return ret;
+				break;
+			default:
+				return -EOPNOTSUPP;
+			}
+			break;
+		case FLOW_ACTION_REDIRECT:
+			odev = act->dev;
+			break;
+		case FLOW_ACTION_CSUM:
+			/* Hardware recomputes checksums on rewrite. */
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+	}
+
+	if (!odev || !eth.seen)
+		return -EOPNOTSUPP;
+
+	if (!edma_port_is_edma_netdev(odev))
+		return -EOPNOTSUPP;
+
+	/* SNAT only: source changed, destination didn't. Declines the
+	 * DNAT/reply direction and anything that changes both or
+	 * neither -- see the file comment.
+	 */
+	if (new_src == match_src || new_dst != match_dst)
+		return -EOPNOTSUPP;
+
+	/* eth.bytes is {h_dest[6], h_source[6]}. The new source half
+	 * must be this egress port's own MAC -- if it isn't, either
+	 * this isn't the flow we think it is or the port's L3_IF entry
+	 * (edma_port_l3_if_update()) is out of sync, and egressing
+	 * with the wrong source MAC either way is worse than declining.
+	 */
+	if (!ether_addr_equal(eth.bytes + ETH_ALEN, odev->dev_addr))
+		return -EOPNOTSUPP;
+
+	port_priv = netdev_priv(odev);
+
+	mutex_lock(&priv->lock);
+
+	if (rhashtable_lookup_fast(&priv->flow_table, &cls->cookie, ppe_offload_flow_ht_params)) {
+		ret = -EEXIST;
+		goto unlock;
+	}
+
+	/* Public IP entry for the translated (post-SNAT) source address. */
+	ret = ppe_pub_ip_pool_get_and_ref(priv->ppe_dev, &priv->pub_ip_pool, new_src,
+					   &pub_ip_index);
+	if (ret)
+		goto unlock;
+
+	/* Nexthop: egress port + resolved next-hop MAC + the public IP
+	 * entry just obtained.
+	 */
+	memset(&nexthop, 0, sizeof(nexthop));
+	nexthop.port_valid = true;
+	/* Assumes this driver's own port_id numbering matches the
+	 * vendor fal_port_t numbering PPE_IN_NEXTHOP_TBL_PORT_VSI
+	 * expects (both apparently 1-based with 0 reserved) -- not
+	 * independently confirmed against vendor source, flagged for
+	 * hardware-test-time verification.
+	 */
+	nexthop.port = port_priv->ppe_port->port_id;
+	nexthop.post_l3_if = port_priv->l3_if_index;
+	nexthop.pub_addr_index = pub_ip_index;
+	memcpy(nexthop.dmac, eth.bytes, ETH_ALEN);
+
+	ret = ppe_nexthop_pool_get_and_ref(priv->ppe_dev, &priv->nexthop_pool, &nexthop,
+					    &nexthop_index);
+	if (ret)
+		goto deref_pub_ip;
+
+	/* Host entry for the original (pre-NAT) source address -- the
+	 * LAN client, shared across every flow through it.
+	 */
+	memset(&host_ipv4, 0, sizeof(host_ipv4));
+	host_ipv4.valid = true;
+	host_ipv4.wan = false;
+	host_ipv4.ip_addr = match_src;
+	ppe_host_ipv4_entry_encode(&host_ipv4, host_words);
+
+	ret = ppe_host_pool_get_and_ref(priv->ppe_dev, &priv->host_pool, PPE_FLOW_OP_MODE_HASH,
+					 host_words, PPE_HOST_TBL_IPV4_ENTRY_WORDS, &host_index);
+	if (ret)
+		goto deref_nexthop;
+
+	memset(&flow_ipv4, 0, sizeof(flow_ipv4));
+	flow_ipv4.valid = true;
+	flow_ipv4.host_addr_is_dst = false;
+	flow_ipv4.host_addr_index = host_index;
+	flow_ipv4.protocol = ip_proto;
+	flow_ipv4.snat_nexthop = nexthop_index;
+	flow_ipv4.snat_src_port = be16_to_cpu(l4.source);
+	flow_ipv4.match_ip = match_dst;
+	flow_ipv4.match_sport = be16_to_cpu(match_sport);
+	flow_ipv4.match_dport = be16_to_cpu(match_dport);
+	ppe_flow_ipv4_snat_entry_encode(&flow_ipv4, flow_words);
+
+	flow_index = 0;
+	ret = ppe_flow_entry_add(priv->ppe_dev, PPE_FLOW_OP_MODE_HASH, flow_words, &flow_index);
+	if (ret)
+		goto deref_host;
+
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry) {
+		ret = -ENOMEM;
+		goto del_flow;
+	}
+
+	entry->cookie = cls->cookie;
+	entry->flow_index = flow_index;
+	entry->host_index = host_index;
+	entry->nexthop_index = nexthop_index;
+	entry->pub_ip_index = pub_ip_index;
+
+	ret = rhashtable_insert_fast(&priv->flow_table, &entry->node, ppe_offload_flow_ht_params);
+	if (ret)
+		goto free_entry;
+
+	mutex_unlock(&priv->lock);
+
+	return 0;
+
+free_entry:
+	kfree(entry);
+del_flow:
+	ppe_flow_entry_del(priv->ppe_dev, flow_index);
+deref_host:
+	ppe_host_pool_deref(priv->ppe_dev, &priv->host_pool, host_index);
+deref_nexthop:
+	ppe_nexthop_pool_deref(priv->ppe_dev, &priv->nexthop_pool, nexthop_index);
+deref_pub_ip:
+	ppe_pub_ip_pool_deref(priv->ppe_dev, &priv->pub_ip_pool, pub_ip_index);
+unlock:
+	mutex_unlock(&priv->lock);
+
+	return ret;
+}
+
+static int ppe_offload_flow_destroy(struct ppe_offload_priv *priv, struct flow_cls_offload *cls)
+{
+	struct ppe_offload_flow_entry *entry;
+
+	mutex_lock(&priv->lock);
+
+	entry = rhashtable_lookup_fast(&priv->flow_table, &cls->cookie, ppe_offload_flow_ht_params);
+	if (!entry) {
+		mutex_unlock(&priv->lock);
+		return -ENOENT;
+	}
+
+	rhashtable_remove_fast(&priv->flow_table, &entry->node, ppe_offload_flow_ht_params);
+
+	ppe_flow_entry_del(priv->ppe_dev, entry->flow_index);
+	ppe_host_pool_deref(priv->ppe_dev, &priv->host_pool, entry->host_index);
+	ppe_nexthop_pool_deref(priv->ppe_dev, &priv->nexthop_pool, entry->nexthop_index);
+	ppe_pub_ip_pool_deref(priv->ppe_dev, &priv->pub_ip_pool, entry->pub_ip_index);
+
+	mutex_unlock(&priv->lock);
+
+	kfree(entry);
+
+	return 0;
+}
