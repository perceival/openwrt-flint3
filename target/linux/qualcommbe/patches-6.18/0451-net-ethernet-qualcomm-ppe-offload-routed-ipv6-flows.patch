+#define PPE_FLOW_TBL_IPV6_L4_DPORT_1		GENMASK(11, 0)
+#define PPE_FLOW_TBL_IPV6_IP_ADDR_0		GENMASK(31, 12)
+
+/* Words 5-7 (IP_ADDR_1..3) are whole words. Word 8: */
+#define PPE_FLOW_TBL_IPV6_IP_ADDR_4		GENMASK(11, 0)
+
 /* TCP-flag exception matchers, in the ingress parser block ("Ingress parse",
  * 0x1e0000, in ppe_readable_ranges[]). Hardware compares each TCP segment's
