+/* Whether the kernel's own route towards @addr leaves through @dev.
+ *
+ * The IPv6 counterpart of the IPv4 DNAT address check: the rule for the
+ * WAN->LAN direction carries no trace of a PPPoE encapsulation on the
+ * WAN (the flowtable resolves the session down to the Ethernet device
+ * and hands the ingress as that device), so a plain-framed entry would
+ * forward a frame that software, with the Ethernet device in no zone,
+ * drops. A peer that software reaches through the device the packets
+ * come in on is the only one such an entry is programmed for. Without
+ * IPv6 in the kernel there are no IPv6 flows to offer, and none are
+ * accepted. The lookup carries no source, mark or interface, so a
+ * peer reached only through a policy-routed table, or through the
+ * other member of an ECMP default route, is declined (fail closed).
+ */
+#if IS_ENABLED(CONFIG_IPV6)
+static bool ppe_offload_ipv6_reached_via(struct net *net, const struct in6_addr *addr,
+					 const struct net_device *dev)
+{
+	struct rt6_info *rt;
+	bool via;
+
+	rt = rt6_lookup(net, addr, NULL, 0, NULL, 0);
+	if (!rt)
+		return false;
+	via = rt->dst.dev == dev;
+	ip6_rt_put(rt);
+
+	return via;
+}
+#else
+static bool ppe_offload_ipv6_reached_via(struct net *net, const struct in6_addr *addr,
+					 const struct net_device *dev)
+{
+	return false;
+}
+#endif
