+ */
+
+#ifndef __PPE_HOST_IPV6_H__
+#define __PPE_HOST_IPV6_H__
+
+#include <linux/in6.h>
+#include <linux/types.h>
+
+#include "ppe_host.h"
+
+/**
+ * struct ppe_host_ipv6_entry - IPv6 host table entry.
+ * @valid: Whether this entry is active.
+ * @wan: True if @ip_addr is a WAN-side address, false if LAN-side.
+ * @ip_addr: The IPv6 address this entry represents.
+ */
+struct ppe_host_ipv6_entry {
+	bool valid;
+	bool wan;
+	struct in6_addr ip_addr;
+};
+
+void ppe_host_ipv6_entry_encode(const struct ppe_host_ipv6_entry *entry,
+				u32 words[PPE_HOST_TBL_IPV6_ENTRY_WORDS]);
+void ppe_host_ipv6_entry_decode(const u32 words[PPE_HOST_TBL_IPV6_ENTRY_WORDS],
+				struct ppe_host_ipv6_entry *entry);
+
+#endif
