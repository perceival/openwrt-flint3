- * post_l3_if when routing/NAT-ing a packet out through this port.
+ * @l3_if_index: This port's L3 interface table index, used for both
+ * the egress and the ingress entry (see ppe_l3_if.h). Set once at port
+ * setup and kept in sync with the netdevice's own MAC address;
+ * referenced by a nexthop entry's post_l3_if when routing/NAT-ing a
+ * packet out through this port, and by a flow entry's src_l3_if when
+ * the packet arrives on it.
  */
 struct edma_port_priv {
 	struct ppe_port *ppe_port;
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
@@ -167,16 +167,28 @@
 	return ret;
 }
 
+static void edma_port_l3_if_update(struct net_device *netdev);
+
 static int edma_port_change_mtu(struct net_device *netdev, int mtu)
 {
 	struct edma_port_priv *port_priv = (struct edma_port_priv *)netdev_priv(netdev);
+	int ret;
 
 	if (!port_priv)
 		return -EINVAL;
 
 	netdev->mtu = mtu;
 
-	return ppe_port_set_maxframe(port_priv->ppe_port, mtu);
+	ret = ppe_port_set_maxframe(port_priv->ppe_port, mtu);
+	if (ret)
+		return ret;
+
+	/* Hardware checks arriving frames against the ingress L3
+	 * interface entry's MRU/MTU, so it has to follow the netdevice.
+	 */
+	edma_port_l3_if_update(netdev);
+
+	return 0;
 }
 
 static netdev_features_t edma_port_feature_check(__maybe_unused struct sk_buff *skb,
@@ -301,24 +313,85 @@
 	ppe_port_get_stats64(port_priv->ppe_port, stats);
 }
 
-/* Program this port's egress L3 interface table entry (own MAC address)
- * to match the netdevice's current MAC. Failure is logged, not
- * propagated: this table isn't consulted by anything on the packet
- * path yet, so it must never block ordinary MAC-address changes or
- * port bring-up from working.
+/* Program this port's L3 interface state to match the netdevice: its
+ * own MAC address (egress entry and MY_MAC), the MTU/MRU hardware
+ * enforces, and the ingress entry's routing enable. Hardware only
+ * routes a frame whose destination MAC matches a MY_MAC entry that the
+ * ingress L3 interface selects, so without all of this a matching flow
+ * entry still cannot be forwarded.
+ *
+ * Each port gets its own MY_MAC entry, indexed from 0 while port ids
+ * (and so L3 interface indices) start at 1, so the 8-entry table holds
+ * one per port.
+ *
+ * Failure is logged, not propagated: it must never block ordinary
+ * MAC-address or MTU changes, or port bring-up. On a lookup miss or a
+ * failed MTU/MRU check hardware redirects to the CPU rather than
+ * dropping (L3_ROUTE_CTRL/_EXT are left at their RDT_TO_CPU defaults),
+ * so traffic falls back to the software path.
  */
 static void edma_port_l3_if_update(struct net_device *netdev)
 {
 	struct edma_port_priv *port_priv = netdev_priv(netdev);
 	struct ppe_l3_if_eg_entry entry = {};
+	struct ppe_l3_if_in_entry in = {};
+	u16 l3_if = port_priv->l3_if_index;
+	u32 my_mac, mtu;
 	int ret;
 
+	/* Port ids, and so L3 interface indices, start at 1; the MY_MAC
+	 * table has one entry per port starting at 0.
+	 */
+	my_mac = l3_if - 1;
+	if (my_mac >= PPE_MY_MAC_TBL_ENTRIES) {
+		netdev_warn(netdev, "no MY_MAC entry for L3 interface %u\n", l3_if);
+		return;
+	}
+
 	memcpy(entry.mac_addr, netdev->dev_addr, ETH_ALEN);
 
-	ret = ppe_l3_if_eg_entry_set(edma_ctx->ppe_dev, port_priv->l3_if_index, &entry);
-	if (ret)
+	ret = ppe_l3_if_eg_entry_set(edma_ctx->ppe_dev, l3_if, &entry);
+	if (ret) {
 		netdev_warn(netdev, "failed to update egress L3 interface entry %u: %d\n",
-			    port_priv->l3_if_index, ret);
+			    l3_if, ret);
+		return;
+	}
+
+	ret = ppe_my_mac_entry_set(edma_ctx->ppe_dev, my_mac, netdev->dev_addr, true);
+	if (ret) {
+		netdev_warn(netdev, "failed to update MY_MAC entry %u: %d\n", my_mac, ret);
+		return;
+	}
+
+	/* A larger MTU than hardware can express just means hardware
+	 * enforces a smaller one and redirects the rest to the CPU.
+	 */
+	mtu = min_t(u32, netdev->mtu, FIELD_MAX(PPE_IN_L3_IF_TBL_MTU));
+
+	in.mru = mtu;
+	in.mtu = mtu;
+	in.mru_ipv6 = mtu;
+	in.mtu_ipv6 = mtu;
+	in.mac_bitmap = BIT(my_mac);
+	in.ipv4_uc_route_en = true;
+	/* Hardware decrements the TTL, so an expired one must come back
+	 * to the CPU (which answers it) rather than being forwarded.
+	 */
+	in.ttl_exceed_cmd = PPE_L3_IF_ACTION_REDIRECT_TO_CPU;
+	in.ttl_exceed_de_acce = true;
+
+	ret = ppe_l3_if_in_entry_set(edma_ctx->ppe_dev, l3_if, &in);
+	if (ret) {
+		netdev_warn(netdev, "failed to update ingress L3 interface entry %u: %d\n",
+			    l3_if, ret);
+		return;
+	}
+
+	ret = ppe_l3_if_port_bind(edma_ctx->ppe_dev, port_priv->ppe_port->port_id,
+				   l3_if, true);
+	if (ret)
+		netdev_warn(netdev, "failed to bind port to L3 interface entry %u: %d\n",
+			    l3_if, ret);
 }
 
 static int edma_port_set_mac_address(struct net_device *netdev, void *macaddr)
@@ -394,7 +467,11 @@
 	struct net_device *netdev = edma_ctx->netdev_arr[port_id - 1];
 	struct edma_port_priv *port_priv = netdev_priv(netdev);
 	struct ppe_l3_if_eg_entry zero = {};
+	struct ppe_l3_if_in_entry in_zero = {};
 
