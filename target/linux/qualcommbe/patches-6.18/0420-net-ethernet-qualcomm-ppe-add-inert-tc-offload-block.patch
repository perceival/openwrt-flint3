--- /dev/null
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_offload.c
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/* PPE hardware flow-offload TC hook -- .ndo_setup_tc entry point for
+ * this driver's netdevices, modeled on drivers/net/ethernet/mediatek/
+ * mtk_ppe_offload.c.
+ *
+ * This is deliberately the *inert* half only: it registers the TC
+ * block callback so the kernel's flow-offload infrastructure can find
+ * this driver and offer it flows, but ppe_offload_flow_cmd() declines
+ * every FLOW_CLS_REPLACE with -EOPNOTSUPP rather than actually parsing
+ * a flow_rule and programming hardware. That is the next piece, and is
+ * gated on its own review -- unlike this file, it will not be inert.
+ *
+ * Only one PPE instance exists per SoC, so a single file-scope block
+ * callback list (rather than one embedded in some per-device context
+ * struct) is sufficient here and avoids introducing state this half
+ * doesn't need. The hardware-programming half will need real
+ * per-device state (an rhashtable of offloaded flows, references to
+ * the host/nexthop pools) and is expected to introduce that struct
+ * when it lands.
+ */
+
+#include <linux/list.h>
+#include <linux/netdevice.h>
+#include <net/flow_offload.h>
+#include <net/pkt_cls.h>
+
+#include "ppe_offload.h"
+
+static LIST_HEAD(ppe_offload_block_cb_list);
+
+static int ppe_offload_flow_cmd(struct net_device *netdev, struct flow_cls_offload *cls)
+{
+	switch (cls->command) {
+	case FLOW_CLS_REPLACE:
+		/* Hardware programming not yet implemented. */
+		return -EOPNOTSUPP;
+	case FLOW_CLS_DESTROY:
+	case FLOW_CLS_STATS:
+		/* Nothing is ever successfully offloaded yet, so the
+		 * kernel never has a reason to call these for a flow
+		 * this driver produced.
+		 */
+		return -EOPNOTSUPP;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int ppe_offload_setup_tc_block_cb(enum tc_setup_type type, void *type_data,
+					  void *cb_priv)
+{
+	struct net_device *netdev = cb_priv;
+
+	if (!tc_can_offload(netdev))
+		return -EOPNOTSUPP;
+
+	switch (type) {
+	case TC_SETUP_CLSFLOWER:
+		return ppe_offload_flow_cmd(netdev, type_data);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int ppe_offload_setup_tc_block(struct net_device *netdev,
+				       struct flow_block_offload *f)
+{
+	struct flow_block_cb *block_cb;
+
+	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		block_cb = flow_block_cb_lookup(f->block, ppe_offload_setup_tc_block_cb,
+						 netdev);
+		if (block_cb) {
+			flow_block_cb_incref(block_cb);
+			return 0;
+		}
+
+		block_cb = flow_block_cb_alloc(ppe_offload_setup_tc_block_cb, netdev,
+						netdev, NULL);
+		if (IS_ERR(block_cb))
+			return PTR_ERR(block_cb);
+
+		flow_block_cb_incref(block_cb);
+		flow_block_cb_add(block_cb, f);
+		list_add_tail(&block_cb->driver_list, &ppe_offload_block_cb_list);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		block_cb = flow_block_cb_lookup(f->block, ppe_offload_setup_tc_block_cb,
+						 netdev);
+		if (!block_cb)
+			return -ENOENT;
+
+		if (!flow_block_cb_decref(block_cb)) {
+			flow_block_cb_remove(block_cb, f);
+			list_del(&block_cb->driver_list);
+		}
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+/**
+ * ppe_offload_setup_tc() - .ndo_setup_tc entry point for PPE hardware offload.
+ * @netdev: The netdevice TC is being configured on.
+ * @type: The TC setup operation.
+ * @type_data: Operation-specific data.
+ *
+ * Return: 0 on success, a negative error code otherwise.
+ */
+int ppe_offload_setup_tc(struct net_device *netdev, enum tc_setup_type type, void *type_data)
+{
+	switch (type) {
+	case TC_SETUP_BLOCK:
+	case TC_SETUP_FT:
+		return ppe_offload_setup_tc_block(netdev, type_data);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
