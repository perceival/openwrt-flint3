+#ifndef __PPE_OFFLOAD_H__
+#define __PPE_OFFLOAD_H__
+
+struct net_device;
+enum tc_setup_type;
+
+int ppe_offload_setup_tc(struct net_device *netdev, enum tc_setup_type type,
