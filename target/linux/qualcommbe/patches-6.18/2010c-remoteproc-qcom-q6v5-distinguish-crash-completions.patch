From: JiaY-shi <shi05275@163.com>
Date: Thu, 27 Aug 2026 20:10:00 +0800
Subject: [PATCH] remoteproc: qcom: q6v5: distinguish crash completions

When a Q6 crashes while its start or stop path is waiting for an IRQ, the
remoteproc recovery worker cannot make progress until that wait times out.
Qualcomm's multi-PD tree wakes all pending waiters from the fatal and
watchdog handlers and records whether the corresponding completion came
from a real ACK or from the crash path.

Apply the same rule to the upstream q6v5 helper used by the IPQ5332 WCSS
RootPD.  Preserve the helper's existing 0/-ETIMEDOUT contract so all of
its PAS, ADSP, MSS and WCSS callers continue to treat a crash wake-up as a
failed handshake.  Preserve a secure-PIL stop handshake error while still
shutting the RootPD down.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
--- a/drivers/remoteproc/qcom_q6v5.c
+++ b/drivers/remoteproc/qcom_q6v5.c
@@ -61,6 +61,8 @@
 	reinit_completion(&q6v5->start_done);
 	reinit_completion(&q6v5->stop_done);
 
+	WRITE_ONCE(q6v5->start_ack, false);
+	WRITE_ONCE(q6v5->stop_ack, false);
 	q6v5->running = true;
 	q6v5->handover_issued = false;
 
@@ -96,6 +98,7 @@
 
 	/* Sometimes the stop triggers a watchdog rather than a stop-ack */
 	if (!q6v5->running) {
+		WRITE_ONCE(q6v5->stop_ack, true);
 		complete(&q6v5->stop_done);
 		return IRQ_HANDLED;
 	}
@@ -108,6 +111,10 @@
 		dev_err(q6v5->dev, "watchdog without message\n");
 
 	q6v5->running = false;
+
+	/* Wake boot/shutdown so recovery does not wait for a timeout. */
+	complete_all(&q6v5->start_done);
+	complete_all(&q6v5->stop_done);
 	rproc_report_crash(q6v5->rproc, RPROC_WATCHDOG);
 
 	return IRQ_HANDLED;
@@ -130,6 +137,10 @@
 		dev_err(q6v5->dev, "fatal error without message\n");
 
 	q6v5->running = false;
+
+	/* Wake boot/shutdown so recovery does not wait for a timeout. */
+	complete_all(&q6v5->start_done);
+	complete_all(&q6v5->stop_done);
 	rproc_report_crash(q6v5->rproc, RPROC_FATAL_ERROR);
 
 	return IRQ_HANDLED;
@@ -139,6 +150,7 @@
 {
 	struct qcom_q6v5 *q6v5 = data;
 
+	WRITE_ONCE(q6v5->start_ack, true);
 	complete(&q6v5->start_done);
 
 	return IRQ_HANDLED;
@@ -151,14 +163,19 @@
  *
  * qcom_q6v5_unprepare() should not be called when this function fails.
  *
- * Return: 0 on success, -ETIMEDOUT on timeout
+ * Return: 0 on success, -ETIMEDOUT on timeout or when a crash woke the
+ * waiter without a ready ACK
  */
 int qcom_q6v5_wait_for_start(struct qcom_q6v5 *q6v5, int timeout)
 {
 	int ret;
 
 	ret = wait_for_completion_timeout(&q6v5->start_done, timeout);
-	return !ret ? -ETIMEDOUT : 0;
+	if (!ret)
+		return -ETIMEDOUT;
+
+	return READ_ONCE(q6v5->start_ack) && READ_ONCE(q6v5->running) ?
+		0 : -ETIMEDOUT;
 }
 EXPORT_SYMBOL_GPL(qcom_q6v5_wait_for_start);
 
@@ -185,6 +201,7 @@
 {
 	struct qcom_q6v5 *q6v5 = data;
 
+	WRITE_ONCE(q6v5->stop_ack, true);
 	complete(&q6v5->stop_done);
 
 	return IRQ_HANDLED;
@@ -202,6 +219,7 @@
 	int ret;
 
+	WRITE_ONCE(q6v5->stop_ack, false);
 	q6v5->running = false;
 
 	/* Don't perform SMP2P dance if remote isn't running */
 	if (q6v5->rproc->state != RPROC_RUNNING || qcom_sysmon_shutdown_acked(sysmon))
@@ -214,7 +232,10 @@
 
 	qcom_smem_state_update_bits(q6v5->state, BIT(q6v5->stop_bit), 0);
 
-	return ret == 0 ? -ETIMEDOUT : 0;
+	if (!ret)
+		return -ETIMEDOUT;
+
+	return READ_ONCE(q6v5->stop_ack) ? 0 : -ETIMEDOUT;
 }
 EXPORT_SYMBOL_GPL(qcom_q6v5_request_stop);
 
--- a/drivers/remoteproc/qcom_q6v5.h
+++ b/drivers/remoteproc/qcom_q6v5.h
@@ -34,6 +34,8 @@
 	struct completion start_done;
 	struct completion stop_done;
 
+	bool start_ack;
+	bool stop_ack;
 	unsigned int crash_reason_smem_host;
 	int crash_reason;
 
--- a/drivers/remoteproc/qcom_q6v5_wcss_sec.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss_sec.c
@@ -103,15 +103,18 @@
 {
 	struct wcss_sec *wcss = rproc->priv;
 	struct device *dev = wcss->dev;
-	int ret;
+	int ret, shutdown_ret;
 
 	ret = qcom_q6v5_request_stop(&wcss->q6, NULL);
 	if (ret == -ETIMEDOUT)
 		dev_err(dev, "timed out on wait\n");
 
-	ret = qcom_scm_pas_shutdown(wcss->desc->pasid);
-	if (ret)
-		dev_err(dev, "Failed to shutdown %d\n", ret);
+	shutdown_ret = qcom_scm_pas_shutdown(wcss->desc->pasid);
+	if (shutdown_ret) {
+		dev_err(dev, "Failed to shutdown %d\n", shutdown_ret);
+		if (!ret)
+			ret = shutdown_ret;
+	}
 
 	qcom_q6v5_unprepare(&wcss->q6);
 
-- 
2.51.0
