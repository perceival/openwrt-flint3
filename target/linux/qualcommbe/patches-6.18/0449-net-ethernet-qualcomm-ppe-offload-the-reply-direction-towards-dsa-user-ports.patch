@@ -319,6 +354,228 @@ static int ppe_offload_apply_l4_mangle(s
 			 ##__VA_ARGS__); \
 	   pr_debug("ppe_offload: declined - " fmt "\n", ##__VA_ARGS__); -EOPNOTSUPP; })
 
+/* Whether a rule carries its VLAN or CVLAN match key.
+ *
+ * The flowtable fills in the VLAN (and CVLAN) key of a tagged ingress
+ * but, unlike for every other key, does not set it in used_keys
+ * (nf_flow_rule_match(), v6.18), so flow_rule_match_key() alone says no
+ * and the pop action that comes with it would be declined as unmatched.
+ * The dissector's offset for the key is set together with the key and is
+ * never 0 for these two (meta comes first in struct nf_flow_key), so it
+ * serves as the second signal. Measured on a GL-BE9300 with wan.10: with
+ * flow_rule_match_key() alone every tagged-WAN reply was declined.
+ */
+static bool ppe_offload_rule_has_vlan_key(const struct flow_rule *rule,
+					  enum flow_dissector_key_id key)
+{
+	/* Only these two: the flowtable sets the offsets of the other keys
+	 * it knows unconditionally, so for them the offset says nothing.
+	 */
+	if (WARN_ON_ONCE(key != FLOW_DISSECTOR_KEY_VLAN && key != FLOW_DISSECTOR_KEY_CVLAN))
+		return false;
+
+	return flow_rule_match_key(rule, key) || rule->match.dissector->offset[key];
+}
+
+/**
+ * struct ppe_offload_egress - Where and how a flow leaves the PPE.
+ * @dev: The EDMA netdevice whose PPE port the nexthop names: the redirect
+ * target itself, the real device under a VLAN netdevice, or the conduit
+ * under a DSA user port.
+ * @stag: Insert an S-VLAN tag with @svid on egress.
+ * @svid: TCI of that tag (12-bit VID field; the insert has no PCP).
+ * @ctag: Insert a C-VLAN tag with @cvid on egress.
+ * @cvid: TCI of that tag.
+ * @dsa_index: Switch port index when the egress is a DSA user port.
+ * @dsa: Whether the egress is a DSA user port at all.
+ * @dsa_fixed: Whether the tag inserts name that port outright (rather than
+ * leaving the choice to the switch's own FDB), see ppe_offload_dsa_egress().
+ */
+struct ppe_offload_egress {
+	struct net_device *dev;
+	bool stag;
+	u16 svid;
+	bool ctag;
+	u16 cvid;
+	unsigned int dsa_index;
+	bool dsa;
+	bool dsa_fixed;
+};
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+/* rtl8_4 head tag words as the nexthop's S-tag and C-tag inserts see them.
+ *
+ * The RTL8372N expects 0x8899 | 0x0400 | <flags> | <port mask> in front
+ * of the EtherType on CPU->switch frames (net/dsa/tag_rtl8_4.c). While the
+ * conduit's parser is aliased (edma_port.c) the chip-wide egress S-TPID is
+ * 0x8899 and the C-TPID 0x8100, so an S-tag insert with TCI 0x0400
+ * reproduces the first two words (protocol 0x04, reason 0: PCP and DEI of
+ * that TCI are the protocol byte's top bits, all zero) and a C-tag insert
+ * with TCI = BIT(port) reproduces the fourth (ALLOW=0, RX = forwarding
+ * port mask). The third word comes out as the egress C-TPID, 0x8100 --
+ * in the tag's flag layout EFID_EN=1 with EFID 0, PRI_EN=0 (so the PRI
+ * bits, 001, are ignored), KEEP=0, VSEL=0, LEARN_DIS=0. An explicit
+ * forwarding port mask does not consult the FDB, so the EFID does not
+ * matter to the egress decision; LEARN_DIS=0 lets the switch learn the
+ * conduit's MAC on its CPU port from these frames, which is where that
+ * address lives anyway. Both TCIs are written to the 12-bit VID fields
+ * with PCP and DEI zero; the egress stage must not remark a PCP into
+ * them (it would corrupt the protocol byte and set ALLOW) -- the nexthop
+ * entry has no PCP field, so this is a hardware property the bench has to
+ * confirm (a corrupted tag is a dropped frame, a visible failure), not
+ * something this code controls. Measured on a GL-BE9300: the switch
+ * accepts the pair as programmed here -- 2353 Mbit/s delivered to the
+ * port at 99.3% CPU idle from a cold boot on the default tagger -- once
+ * the conduit is an S-VLAN egress port (edma_port.c); left a C-VLAN
+ * port, the S-tag never comes out and the switch delivers nothing.
+ * Frames a LAN port forges with a 0x8899 head of its own arrive at the
+ * conduit as data inside the switch's genuine head tag (measured), so
+ * nothing a client sends can pose as this emulation either.
+ *
+ * Always the port outright, never the switch's own FDB: an untagged frame
+ * would be classified to the CPU port's PVID, which under this tagger is
+ * the seeded VLAN 1 that every port is a member of, so an FDB miss would
+ * flood a routed frame across every bridge on the switch.
+ */
+#define PPE_OFFLOAD_RTL8_4_STAG_TCI	0x0400
+/* Width of the tag's RX (forwarding port mask) field. */
+#define PPE_OFFLOAD_RTL8_4_RX_BITS	11
+
+/* Resolve a redirect to a DSA user port into the conduit's PPE port plus
+ * the tag inserts that make the switch deliver the frame to that port,
+ * mirroring mtk_flow_get_dsa_port() for the port lookup. Hardware cannot
+ * run the DSA tagger, so the switch has to be addressed with what the
+ * nexthop table can insert -- one C-tag and one S-tag -- which depends on
+ * the tagger in use and on the parser (and with it the chip-wide egress
+ * TPIDs) being programmed for that tagger on the conduit:
+ *
+ * - tag_8021q (vsc73xx-8021q): a C-tag with the port's tag_8021q VID.
+ *   For a port of a VLAN-unaware bridge that is the bridge VID, exactly
+ *   what the software tagger sends straight onto a bridged port: the
+ *   switch then picks the egress port from its own FDB, so a client that
+ *   moves ports is followed by the hardware flow as well (measured: the
+ *   download resumed in hardware after a re-cable), and a miss floods no
+ *   further than the bridge's members. An unbridged port gets its
+ *   standalone VID, whose only other member is the CPU port.
+ * - rtl8_4: the head tag emulated as S-tag + C-tag with the port's
+ *   forwarding mask (see PPE_OFFLOAD_RTL8_4_STAG_TCI).
+ *
+ * Only the DSA structures of the redirect target decide the port; the
+ * switch's FDB is never read. Declined: a port of a VLAN-aware bridge
+ * (its frames would need the bridge VLAN as a further tag, and the
+ * VLAN-unaware bridge VID trick does not apply), a conduit in a LAG, a
+ * VLAN push on top of the port, a tagger without an encapsulation here,
+ * and a conduit whose parser state does not match the tagger.
