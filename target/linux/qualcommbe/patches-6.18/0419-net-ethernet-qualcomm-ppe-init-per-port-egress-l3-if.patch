From: Kamil Bienkiewicz <perceivalpercy@gmail.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: init per-port egress L3
 interface entry

Continuation of the PPE hardware flow-offload port -- see
project_flint3_ppe_hw_offload_research.md for the full architectural
context. A nexthop entry's post_l3_if unconditionally indexes the
egress L3 interface table (0416); that table needs one entry per
egress netdevice, holding the netdevice's own MAC address, before any
nexthop can reference it correctly.

Wire this up at the natural point in this driver's own lifecycle:
edma_port_setup() (after the netdevice's MAC address is finalized,
whether from device tree or random), edma_port_set_mac_address()
(keeping the entry in sync with runtime MAC changes), and
edma_port_destroy() (clearing the entry on teardown). Use the port ID
directly as the L3_IF index (1-based, matching existing port
numbering) -- with only 3-8 ports against a 256-entry table there's no
allocator needed, and leaving index 0 permanently unused avoids
collision with a zero-initialized (i.e. not-yet-programmed)
post_l3_if field defaulting to port 1's entry by accident.

Unlike 0411-0418, this patch is not inert dead code: it performs a
real hardware register write during normal port bring-up on every
boot, not just new code nothing calls. It should still have no
observable effect on packet forwarding -- nothing reads this table
yet, since no nexthop entries exist yet either -- but it is the first
patch in this series to execute on real hardware as part of ordinary
operation rather than sit completely unreferenced, and is flagged as
such rather than bundled in as routine.

Compile-tested only; no hardware testing has been done.

Signed-off-by: Kamil Bienkiewicz <perceivalpercy@gmail.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.h
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.h
@@ -83,6 +83,10 @@
  * @pcpu_stats: Per CPU netdev statistics
  * @txr_map: Tx ring per-core mapping
  * @flags: Feature flags
+ * @l3_if_index: This port's egress L3 interface table index (see
+ * ppe_l3_if.h). Set once at port setup and kept in sync with the
+ * netdevice's own MAC address; referenced by a nexthop entry's
+ * post_l3_if when routing/NAT-ing a packet out through this port.
  */
 struct edma_port_priv {
 	struct ppe_port *ppe_port;
@@ -90,6 +94,7 @@
 	struct edma_port_pcpu_stats pcpu_stats;
 	struct edma_txdesc_ring *txr_map[EDMA_PORT_MAX_CORE];
 	unsigned long flags;
+	u16 l3_if_index;
 };
 
 void edma_port_destroy(struct ppe_port *port);
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
@@ -15,6 +15,7 @@
 #include "edma_cfg_rx.h"
 #include "edma_cfg_tx.h"
 #include "edma_port.h"
+#include "ppe_l3_if.h"
 #include "ppe_regs.h"
 
 /* Number of netdev queues. */
@@ -299,6 +300,26 @@
 	ppe_port_get_stats64(port_priv->ppe_port, stats);
 }
 
+/* Program this port's egress L3 interface table entry (own MAC address)
+ * to match the netdevice's current MAC. Failure is logged, not
+ * propagated: this table isn't consulted by anything on the packet
+ * path yet, so it must never block ordinary MAC-address changes or
+ * port bring-up from working.
+ */
+static void edma_port_l3_if_update(struct net_device *netdev)
+{
+	struct edma_port_priv *port_priv = netdev_priv(netdev);
+	struct ppe_l3_if_eg_entry entry = {};
+	int ret;
+
+	memcpy(entry.mac_addr, netdev->dev_addr, ETH_ALEN);
+
+	ret = ppe_l3_if_eg_entry_set(edma_ctx->ppe_dev, port_priv->l3_if_index, &entry);
+	if (ret)
+		netdev_warn(netdev, "failed to update egress L3 interface entry %u: %d\n",
+			    port_priv->l3_if_index, ret);
+}
+
 static int edma_port_set_mac_address(struct net_device *netdev, void *macaddr)
 {
 	struct edma_port_priv *port_priv = (struct edma_port_priv *)netdev_priv(netdev);
@@ -323,6 +344,7 @@
 	}
 
 	eth_commit_mac_addr_change(netdev, addr);
+	edma_port_l3_if_update(netdev);
 
 	return 0;
 }
@@ -350,6 +372,10 @@
 {
 	int port_id = port->port_id;
 	struct net_device *netdev = edma_ctx->netdev_arr[port_id - 1];
+	struct edma_port_priv *port_priv = netdev_priv(netdev);
+	struct ppe_l3_if_eg_entry zero = {};
+
+	ppe_l3_if_eg_entry_set(edma_ctx->ppe_dev, port_priv->l3_if_index, &zero);
 
 	edma_port_deconfigure(netdev);
 	edma_port_stats_free(netdev);
@@ -408,6 +434,7 @@
 
 	port_priv->ppe_port = port;
 	port_priv->netdev = netdev;
+	port_priv->l3_if_index = port_id;
 	netdev->watchdog_timeo = 5 * HZ;
 	netdev->priv_flags |= IFF_LIVE_ADDR_CHANGE;
 	netdev->netdev_ops = &edma_port_netdev_ops;
@@ -426,6 +453,8 @@
 			    port_id, netdev->dev_addr);
 	}
 
+	edma_port_l3_if_update(netdev);
+
 	ret = edma_port_stats_alloc(netdev);
 	if (ret) {
 		netdev_dbg(netdev, "EDMA port stats alloc failed\n");
