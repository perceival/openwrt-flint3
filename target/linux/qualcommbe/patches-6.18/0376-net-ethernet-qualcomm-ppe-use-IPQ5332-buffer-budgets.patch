From: Francois Guerraz <kubrick@fgv6.net>
Subject: [PATCH] net: ethernet: qualcomm: ppe: use IPQ5332 buffer budgets

The BM and QM configuration is the IPQ9574 one on every SoC: 1550
buffers in the shared BM group, 15 BM ports, a QM group of 2000 buffers
and unicast queue ceilings of 1200. The vendor SSDK gives the IPQ5332 a
much smaller budget: a shared BM group of 240 buffers with 12 dedicated
buffers per port and ceilings of 30 (EDMA) and 48 (physical ports), only
10 BM ports (0-7 for EDMA, 8-9 for the two physical ports), a QM group of
500 and queue ceilings of 50 with weight 5 and resume offset 18. The
stock GL-BE9300 firmware reports exactly those QM values at run time,
and its qca-ssdk.ko carries the same constants.

Program the vendor MPPE budgets when the PPE is an IPQ5332. Values are
from qca_hppe_bm_hw_init() and qca_hppe_qm_hw_init() in the public
qca-ssdk source, src/init/ssdk_hppe.c. BM flow control on the physical
ports keeps following the port's transmit flow control, which is also
what the vendor does once a port is configured ("keep bm status same
with port" in its txfc status setter).

Signed-off-by: Francois Guerraz <kubrick@fgv6.net>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
@@ -230,6 +230,40 @@
 	},
 };
 
+/* The IPQ5332 PPE has 10 BM ports: BM port (0-7) is for EDMA port 0 and
+ * BM port (8-9) is for PPE physical port 1-2. Its buffer budget is much
+ * smaller than the IPQ9574 one: 240 buffers are assigned to the shared
+ * group 0. Values are from the vendor SSDK, qca_hppe_bm_hw_init() for MPPE.
+ */
+static const int ipq5332_ppe_bm_group_config = 240;
+
+static const struct ppe_bm_port_config ipq5332_ppe_bm_port_config[] = {
+	{
+		/* Buffer configuration for the BM port ID 0-7 of EDMA. */
+		.port_id_start	= 0,
+		.port_id_end	= 7,
+		.pre_alloc	= 12,
+		.in_fly_buf	= 40,
+		.ceil		= 30,
+		.weight		= 7,
+		.resume_offset	= 5,
+		.resume_ceil	= 20,
+		.dynamic	= true,
+	},
+	{
+		/* Buffer configuration for the BM port ID 8-9 of PPE ports. */
+		.port_id_start	= 8,
+		.port_id_end	= 9,
+		.pre_alloc	= 12,
+		.in_fly_buf	= 128,
+		.ceil		= 48,
+		.weight		= 7,
+		.resume_offset	= 5,
+		.resume_ceil	= 20,
+		.dynamic	= true,
+	},
+};
+
 /* QM fetches the packet from PPE buffer management for transmitting the
  * packet out. The QM group configuration limits the total number of buffers
  * enqueued by all PPE hardware queues.
@@ -264,6 +298,35 @@
 	},
 };
 
+/* QM group and queue settings for the IPQ5332, from the vendor SSDK,
+ * qca_hppe_qm_hw_init() for MPPE: 500 buffers for group 0, dynamic
+ * thresholds for the unicast queues and static ones for multicast.
+ */
+static const int ipq5332_ppe_qm_group_config = 500;
+
+static const struct ppe_qm_queue_config ipq5332_ppe_qm_queue_config[] = {
+	{
+		/* QM settings for unicast queues 0 to 255. */
+		.queue_start	= 0,
+		.queue_end	= 255,
+		.prealloc_buf	= 0,
+		.ceil		= 50,
+		.weight		= 5,
+		.resume_offset	= 18,
+		.dynamic	= true,
+	},
+	{
+		/* QM settings for multicast queues 256 to 299. */
+		.queue_start	= 256,
+		.queue_end	= 299,
+		.prealloc_buf	= 0,
+		.ceil		= 50,
+		.weight		= 0,
+		.resume_offset	= 18,
+		.dynamic	= false,
+	},
+};
+
 /* PPE scheduler configuration for BM includes multiple entries. Each entry
  * indicates the primary port to be assigned the buffers for the ingress or
  * to release the buffers for the egress. Backup port ID will be used when
@@ -1603,16 +1666,25 @@
 {
 	const struct ppe_bm_port_config *port_cfg;
 	unsigned int i, bm_port_id, port_cfg_cnt;
+	int ret, group_limit;
 	u32 reg, val;
-	int ret;
+
+	if (ppe_is_ipq5332(ppe_dev)) {
+		group_limit = ipq5332_ppe_bm_group_config;
+		port_cfg = ipq5332_ppe_bm_port_config;
+		port_cfg_cnt = ARRAY_SIZE(ipq5332_ppe_bm_port_config);
+	} else {
+		group_limit = ipq9574_ppe_bm_group_config;
+		port_cfg = ipq9574_ppe_bm_port_config;
+		port_cfg_cnt = ARRAY_SIZE(ipq9574_ppe_bm_port_config);
+	}
 
 	/* Configure the allocated buffer number only for group 0.
 	 * The buffer number of group 1-3 is already cleared to 0
 	 * after PPE reset during the probe of PPE driver.
 	 */
 	reg = PPE_BM_SHARED_GROUP_CFG_ADDR;
-	val = FIELD_PREP(PPE_BM_SHARED_GROUP_CFG_SHARED_LIMIT,
-			 ipq9574_ppe_bm_group_config);
+	val = FIELD_PREP(PPE_BM_SHARED_GROUP_CFG_SHARED_LIMIT, group_limit);
 	ret = regmap_update_bits(ppe_dev->regmap, reg,
 				 PPE_BM_SHARED_GROUP_CFG_SHARED_LIMIT,
 				 val);
@@ -1620,8 +1692,6 @@
 		goto bm_config_fail;
 
 	/* Configure buffer thresholds for the BM ports. */
-	port_cfg = ipq9574_ppe_bm_port_config;
-	port_cfg_cnt = ARRAY_SIZE(ipq9574_ppe_bm_port_config);
 	for (i = 0; i < port_cfg_cnt; i++) {
 		for (bm_port_id = port_cfg[i].port_id_start;
 		     bm_port_id <= port_cfg[i].port_id_end; bm_port_id++) {
@@ -1649,6 +1719,17 @@
 	u32 reg, multicast_queue_cfg[5];
 	u32 unicast_queue_cfg[4];
 	u32 group_cfg[3];
+	int group_limit;
+
+	if (ppe_is_ipq5332(ppe_dev)) {
+		group_limit = ipq5332_ppe_qm_group_config;
+		queue_cfg = ipq5332_ppe_qm_queue_config;
+		queue_cfg_count = ARRAY_SIZE(ipq5332_ppe_qm_queue_config);
+	} else {
+		group_limit = ipq9574_ppe_qm_group_config;
+		queue_cfg = ipq9574_ppe_qm_queue_config;
+		queue_cfg_count = ARRAY_SIZE(ipq9574_ppe_qm_queue_config);
+	}
 
 	/* Assign the buffer number to the group 0 by default. */
 	reg = PPE_AC_GRP_CFG_TBL_ADDR;
@@ -1657,15 +1738,13 @@
 	if (ret)
 		goto qm_config_fail;
 
-	PPE_AC_GRP_SET_BUF_LIMIT(group_cfg, ipq9574_ppe_qm_group_config);
+	PPE_AC_GRP_SET_BUF_LIMIT(group_cfg, group_limit);
 
 	ret = regmap_bulk_write(ppe_dev->regmap, reg,
 				group_cfg, ARRAY_SIZE(group_cfg));
 	if (ret)
 		goto qm_config_fail;
 
-	queue_cfg = ipq9574_ppe_qm_queue_config;
-	queue_cfg_count = ARRAY_SIZE(ipq9574_ppe_qm_queue_config);
 	for (i = 0; i < queue_cfg_count; i++) {
 		queue_id = queue_cfg[i].queue_start;
 
