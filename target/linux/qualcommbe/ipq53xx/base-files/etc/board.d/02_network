. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

ipq53xx_setup_interfaces()
{
	local board="$1"
	local lan_mac wan_mac

	case "$board" in
	ubnt,u7-pro-xgs)
		ucidef_set_interface_lan "lan"
		;;
	gl.inet,gl-be6500)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		wan_mac=$(mtd_get_mac_binary "0:art" 0xa)
		if [ -n "$wan_mac" ]; then
			lan_mac=$(macaddr_add "$wan_mac" 1)
			ucidef_set_network_device_mac "wan" "$wan_mac"
			ucidef_set_network_device_mac "lan" "$lan_mac"
			ucidef_set_interface_macaddr "wan" "$wan_mac"
			ucidef_set_interface_macaddr "lan" "$lan_mac"
			ucidef_set_label_macaddr "$wan_mac"
		fi
		;;
	gl.inet,gl-be9300)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

ipq53xx_setup_wlan()
{
	local board="$1"
	local art country

	case "$board" in
	gl.inet,gl-be9300)
		# Factory regulatory domain: two letters at ART 0x88, stock's
		# gl-hw factory_data country_code. wifi config writes it into
		# every radio section it creates, including radios that register
		# long after boot, so no script has to wait for them.
		art=$(find_mmc_part "0:ART")
		[ -n "$art" ] || return
		country=$(dd if="$art" bs=1 skip=136 count=2 2>/dev/null |
			tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
		# Unprogrammed: leave the country unset (no fallback, as before);
		# hotplug.d/ieee80211/40-gl-wireless-country logs what to do.
		[ "${#country}" = 2 ] && ucidef_set_country "$country"
		;;
	esac
}

board_config_update
board=$(board_name)
ipq53xx_setup_interfaces $board
ipq53xx_setup_wlan $board
board_config_flush

exit 0
