[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

board=$(board_name)

case "$FIRMWARE" in
"ath12k/IPQ5332/hw1.0/cal-ahb-c000000.wifi.bin")
	case "$board" in
	gl.inet,gl-be6500)
		caldata_extract "0:art" 0x1000 0x20000
		;;
	gl.inet,gl-be9300)
		# 0xf800 bytes, as GL firmware extracts (ftm.conf ap-mi01.6,
		# offset 4096, length of the board-id BDF): the block header
		# carries length 0xf800 and the BDF checksum (XOR of all
		# 16-bit words = 0xffff) holds over exactly this window of
		# the ART partition of a live unit
		caldata_extract_mmc "0:ART" 0x1000 0xf800
		;;
	esac
	;;
"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
	case "$board" in
	gl.inet,gl-be6500)
		caldata_extract "0:art" 0x58800 0x18800
		;;
	gl.inet,gl-be9300)
		# dualmac QCN9274: cal block is 0x27800 long (verified
		# against the ART partition dump from a live unit)
		caldata_extract_mmc "0:ART" 0x58800 0x27800
		;;
	esac
	;;
*)
	exit 1
	;;
esac
