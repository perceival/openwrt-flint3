#!/bin/sh
# ath12k takes its MAC from firmware board data and has no DT/nvmem support,
# so without this every boot invents a new base address and all BSSIDs move.
# Pin each BSS to an address derived from the factory ART value (offset 0x04,
# what stock uses for wlan0). Sections that already set macaddr are left alone.
. /lib/functions.sh
. /lib/functions/system.sh

[ "$(board_name)" = "gl.inet,gl-be9300" ] || exit 0

base=$(mmc_get_mac_binary 0:ART 0x4)
[ -n "$base" ] || exit 0

# get_mac_binary is a bare hexdump with no validation, so a blank or clobbered
# 0:ART yields 00:00:00:00:00:00 or ff:ff:ff:ff:ff:ff, both of which pass the
# test above and would pin every BSS to an unusable BSSID. 802.11 requires the
# BSSID to be an individual address. Fall back to ath12k's own addressing.
case "$base" in
00:00:00:00:00:00|ff:ff:ff:ff:ff:ff)
	logger -t gl-be9300 -p daemon.warn \
		"0:ART base MAC reads $base; leaving BSSIDs to ath12k"
	exit 0
	;;
esac

if [ $(( 0x${base%%:*} & 1 )) -ne 0 ]; then
	logger -t gl-be9300 -p daemon.warn \
		"0:ART base MAC $base is a group address; leaving BSSIDs to ath12k"
	exit 0
fi

n=0
set_wifi_mac() {
	local section="$1"
	config_get mac "$section" macaddr
	[ -n "$mac" ] && return 0		# explicitly pinned already
	config_get mode "$section" mode
	[ "$mode" = "ap" ] || return 0		# leave sta/mesh alone

	local addr
	if [ "$n" = 0 ]; then
		addr="$base"
	else
		addr=$(macaddr_setbit_la "$(macaddr_add "$base" $n)")
	fi
	uci set "wireless.$section.macaddr=$addr"
	n=$((n + 1))
}

config_load wireless
config_foreach set_wifi_mac wifi-iface
uci commit wireless

exit 0
